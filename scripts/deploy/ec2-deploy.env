# Per-box deployment settings. The single place where the paths live.
#
# ec2-release.sh, ec2-autosync.service and ec2-queue-worker.service all read
# this, so a box whose layout differs is one edit rather than four - and the
# script and the units cannot drift into disagreeing about where the app is,
# which is how /var/www/AdminPanel and /var/www/ec-healthcare both ended up in
# this repo's history.
#
# Install to /etc/ec2-deploy.env (root-owned, 0644 - it holds no secrets; the
# app's secrets stay in $APP_PATH/.env, which nothing here touches):
#
#   sudo cp scripts/deploy/ec2-deploy.env /etc/ec2-deploy.env
#   sudo ${EDITOR:-nano} /etc/ec2-deploy.env
#
# systemd parses this file itself, so: no `export`, no shell expansion, no
# command substitution. Literal values only.

# Live Laravel root. Verify with `ls -d /var/www/*` before trusting it.
APP_PATH=/var/www/AdminPanel

# Branch autosync tracks.
GIT_BRANCH=sprint1_dev

# Absolute path - systemd units cannot resolve a bare `php` off PATH.
PHP_BIN=/usr/bin/php

# Web server to reload after a deploy. Set it explicitly: the fallback probe in
# reload_fpm() cannot tell a missing unit from a present one on every systemd
# version, so leaving this blank risks reloading nothing at all.
PHP_FPM_SERVICE=apache2

# Deploy snapshots: where they go and how many are kept.
BACKUP_DIR=/var/www/backups/AdminPanel
BACKUP_KEEP=5
